# Environment variables read by app/config/server.ts and app/config/build.ts.
# Local development: copy to .env.local. Docker Compose: copy to .env.
# Vercel: set them in the project's Environment Variables page.
# test/env-template.test.ts keeps this file in sync with the code.

# --- Upstream model API ------------------------------------------------------

# Server API key used when a user authenticates with an access code.
OPENAI_API_KEY=

# Upstream base URL. Default: https://api.openai.com
# Any OpenAI-compatible gateway works, e.g. OpenRouter through Cloudflare AI
# Gateway: https://gateway.ai.cloudflare.com/v1/<account-id>/<gateway>/openrouter
BASE_URL=

# OpenAI organization ID (optional).
OPENAI_ORG_ID=

# Docker image only: run the server behind this proxy via proxychains.
# Example: http://127.0.0.1:7890
PROXY_URL=

# --- Access control ----------------------------------------------------------

# Access codes, comma separated. When set, users must enter one.
CODE=

# Set to 1 to forbid users from entering their own API key.
HIDE_USER_API_KEY=

# Set to 1 to hide GPT-4 class models.
DISABLE_GPT4=

# Set to 1 to disable importing settings from URL parameters.
DISABLE_FAST_LINK=

# Set to 1 to allow querying the OpenAI account balance.
ENABLE_BALANCE_QUERY=

# --- Models ------------------------------------------------------------------

# Add (+name), hide (-name) or rename (name=display) models, comma separated.
# Example: +openai/gpt-4o-mini,-gpt-4,anthropic/claude-sonnet-4=Claude
CUSTOM_MODELS=

# Default model for new chats, e.g. openai/gpt-4o-mini
DEFAULT_MODEL=

# Additional model names that accept images, comma separated.
VISION_MODELS=

# Custom user input preprocessing template.
DEFAULT_INPUT_TEMPLATE=

# --- Other providers (optional) ---------------------------------------------

AZURE_URL=
AZURE_API_KEY=
AZURE_API_VERSION=

STABILITY_URL=
STABILITY_API_KEY=

# RAGFlow knowledge base; requests to /api/ragflow go only to RAGFLOW_URL.
RAGFLOW_URL=
RAGFLOW_API_KEY=

# --- Features (optional) -----------------------------------------------------

# Set to true to enable MCP tool calling.
ENABLE_MCP=

# Extra WebDAV endpoints allowed for chat sync, comma separated.
WHITE_WEBDAV_ENDPOINTS=

# Cloudflare KV storage for shared Artifacts.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_KV_API_KEY=
# Seconds before a shared artifact expires (values <= 60 mean no expiry).
CLOUDFLARE_KV_TTL=

# Google Analytics / Tag Manager IDs.
GA_ID=
GTM_ID=
