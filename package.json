{
  "name": "nextchat",
  "private": true,
  "license": "MIT",
  "scripts": {
    "mask": "npx tsx app/masks/build.ts",
    "mask:watch": "npx watch \"yarn mask\" app/masks",
    "dev": "concurrently -r \"yarn run mask:watch\" \"next dev\"",
    "build": "bash scripts/ensure-node.sh yarn mask && bash scripts/ensure-node.sh cross-env BUILD_MODE=standalone next build --webpack",
    "vercel-build": "bash scripts/ensure-node.sh yarn mask && bash scripts/ensure-node.sh cross-env BUILD_MODE=standalone next build --webpack",
    "vercel-build:analyze": "ANALYZE=true yarn vercel-build",
    "start": "bash scripts/ensure-node.sh next start",
    "lint": "eslint .",
    "prompts": "node ./scripts/fetch-prompts.mjs",
    "prepare": "husky install",
    "test": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --watch",
    "test:ci": "node --no-warnings --experimental-vm-modules $(yarn bin jest) --ci --coverage"
  },
  "dependencies": {
    "@fortaine/fetch-event-source": "^3.0.6",
    "@hello-pangea/dnd": "18.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "@next/third-parties": "16.4.5",
    "@svgr/webpack": "^6.5.1",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.0.2",
    "axios": "1.21.0",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.9.2",
    "fuse.js": "7.5.0",
    "heic2any": "^0.0.4",
    "html-to-image": "1.11.13",
    "idb-keyval": "6.3.0",
    "js-tiktoken": "^1.0.21",
    "js-yaml": "4.1.0",
    "lodash-es": "^4.17.21",
    "markdown-to-txt": "^2.0.1",
    "mermaid": "^10.6.1",
    "nanoid": "^5.0.3",
    "next": "16.4.5",
    "node-fetch": "3.3.2",
    "openapi-client-axios": "7.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^8.0.7",
    "react-router-dom": "^6.15.0",
    "rehype-highlight": "^6.0.0",
    "rehype-katex": "^6.0.3",
    "remark-breaks": "^3.0.2",
    "remark-gfm": "^3.0.1",
    "remark-math": "^5.1.1",
    "rt-client": "https://github.com/Azure-Samples/aoai-realtime-audio-sdk/releases/download/js/v0.5.0/rt-client-0.5.0.tgz",
    "sass": "^1.59.2",
    "spark-md5": "^3.0.2",
    "use-debounce": "^9.0.4",
    "zod": "3.24.1",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.5",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/spark-md5": "^3.0.4",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^13.2.2",
    "prettier": "3.9.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.16.0",
    "typescript": "5.2.2",
    "watch": "^1.0.2",
    "webpack": "^5.88.1"
  },
  "resolutions": {
    "lint-staged/yaml": "^2.2.2"
  },
  "packageManager": "yarn@1.22.19",
  "engines": {
    "node": ">=20.19.0 <=26.x"
  }
}
